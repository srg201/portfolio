# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: Project Settings → API Keys ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...), безопасен для браузера при включённом RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), только сервер. Обходит RLS
SUPABASE_SECRET_KEY=

# --- Postgres для Drizzle: кнопка Connect в шапке проекта Supabase ---
# Transaction pooler (порт 6543): запросы приложения, serverless
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (порт 5432) или Direct connection: миграции drizzle-kit
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Sanity: контент сайта и админка /admin ---
# sanity.io/manage → ваш проект: Project ID и имя датасета
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Секрет вебхука публикации (любая длинная случайная строка, та же в sanity.io/manage → API → Webhooks)
SANITY_REVALIDATE_SECRET=
# Токен с правами Editor: только для `pnpm sanity:seed` (перенос текущих проектов в Sanity)
SANITY_API_WRITE_TOKEN=

# --- Заявки из квиза на /contact: письмо владельцу (lib/mail.ts) ---
# Gmail SMTP (порты 465/587; локально их может закрывать VPN, на Vercel открыты)
# Адрес Gmail, с которого уходят письма. На него же приходят заявки
GMAIL_USER_NAME=
# Пароль приложения (не обычный пароль!): myaccount.google.com/apppasswords,
# нужна включённая двухэтапная проверка
GMAIL_APP_PASSWORD=
# Куда приходят заявки, если не на GMAIL_USER_NAME (необязательно)
LEADS_EMAIL=

# --- Позже: автоперевод в админке (этап 8) ---
ANTHROPIC_API_KEY=
